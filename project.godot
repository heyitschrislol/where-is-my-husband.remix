; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="WhereIsMyHusband.remix"
run/main_scene="uid://bnxweo4w86il6"
run/enable_alt_space_menu=true
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Dialogic="*uid://ds2q0uclmolvu"
PmailServer="*uid://c2ieblvoyg8q"
InteractionManager="*uid://bx8fmu533p70h"
Gamedata="*uid://b3joqbgohcl3p"
Overlay="*uid://cp6d10e0e1gm5"

[debug]

file_logging/enable_file_logging=true
file_logging/max_log_files=10
settings/gdscript/always_track_local_variables=true
shapes/collision/draw_2d_outlines=false

[dialogic]

layout/style_directory={
"mainstyle": "res://resources/dialogic/mainstyle.tres"
}
extensions_folder="res://addons/dialogic_additions"
text/letter_speed=0.015
text/initial_text_reveal_skippable=true
text/text_reveal_skip_delay=0.1
text/advance_delay=0.3
text/autoadvance_per_character_delay=0.1
text/autoadvance_ignored_characters_enabled=true
animations/join_default_length=0.5
animations/join_default_wait=false
animations/leave_default_length=0.5
animations/leave_default_wait=false
animations/cross_fade_default_length=0.5
choices/autofocus_first=true
choices/delay=0.2
choices/reveal_delay=0
choices/reveal_by_input=false
save/autosave_delay=60.0
save/encryption_on_exports_only=true
text/autopauses={}
audio/channel_defaults={
"": {
"audio_bus": "",
"fade_length": 0.0,
"loop": false,
"volume": 0.0
},
"letter-scroll-sfx": {
