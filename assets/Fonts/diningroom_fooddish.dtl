if {SMOKE.FED} == false:
	if {SMOKE.LET_INSIDE} == false:
		bailey (default): It's a small, tin tray sitting on the ground. It's empty.
		[end_timeline]
	else:
		if {HOLDING_CAT_FOOD} == true:
			bailey (thinking): Now where can I put this food for Smoke?
			bailey (surprised): Oh this little tray looks like a good place!
			bailey (playful): Here you go, Smoke
			[signal arg="feed_smoke"]
			set {HOLDING_CAT_FOOD} = false
			
			smoke (content): Mrrrow-ckkrowww....
			bailey (playful): You were hungry, huh buddy?
			[signal arg="smoke_fed"]
			set {SMOKE.FED} = true
			[end_timeline]
		elif {HOLDING_CAT_FOOD} == false:
			bailey (default): It's a small, tin tray sitting on the ground. It's empty.
			[end_timeline]
else:
		bailey (surprised): Smoke ate all of the food I put here already!
		[end_timeline]